# ============================================================================
# PUSH RUSH — Environment Configuration Example
# Copy this file to `.env.local` for local development or configure in Vercel
# ============================================================================

# Required: Supabase Project URL & Public Anon Key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Public canonical site URL (used for metadata & auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Server-only secret token allowing an authenticated owner to promote
# their own account to administrator via /admin bootstrap panel.
# Never prefix this variable with NEXT_PUBLIC_!
ADMIN_BOOTSTRAP_SECRET=
